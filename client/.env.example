# Optional. Leave unset when using the Vite proxy locally, or a Vercel
# rewrite that forwards /api to the Render API (same-origin cookies, SameSite=Lax).
#
# Set this only if the browser should call Render directly:
#   VITE_API_BASE=https://your-api.onrender.com/api
# In that split-domain case the API must set COOKIE_SAMESITE=none (and Secure).
# VITE_API_BASE=
