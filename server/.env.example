# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string (Atlas free tier works fine for this project)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bibdrop

# Redis for the async research queue (BullMQ). Required for the hosted path
# (API returns 202 and a worker process runs Claude). Local: `docker run -p 6379:6379 redis:7`
REDIS_URL=redis://127.0.0.1:6379

# Cookie-JWT signing secret. Required for login/register and for triggering research.
JWT_SECRET=change-me-to-a-long-random-string

# Your Anthropic API key. This must ONLY ever live on the server - never
# ship it to the client bundle or expose it in a public route.
ANTHROPIC_API_KEY=sk-ant-...

# Comma-separated list of origins allowed to call this API (your deployed
# frontend URL, plus localhost for local dev).
ALLOWED_ORIGINS=http://localhost:5173

# Guardrails against a public demo being used to run up your Anthropic bill.
# Adjust these to taste once you see real usage patterns.
RESEARCH_RATE_LIMIT_PER_IP_PER_HOUR=5
RESEARCH_DAILY_BUDGET_CAP=50

# Reuse a succeeded ResearchSnapshot for this race instead of spending Claude
# again. Window is 6–24h; 12h is the default.
RESEARCH_SNAPSHOT_TTL_HOURS=12

# LOCAL DEMOS ONLY. If Redis is down/unconfigured, run Claude inside the API
# process (still writes a ResearchSnapshot, but the HTTP request waits). Never
# enable this on Render/production — the hosted path must be async via the worker.
# RESEARCH_SYNC_FALLBACK=true

# Email alerts (watching races only). Without a key, Alert rows are still
# scheduled; the hourly scanner logs and does not send. Resend is preferred.
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG....
# ALERT_FROM_EMAIL=BibDrop <alerts@yourdomain.com>

# Discovery is open-ended (freeform criteria, not a fixed known race) so it
# gets its own, stricter budget - see raceDiscovery.js for why.
DISCOVERY_RATE_LIMIT_PER_IP_PER_HOUR=2
DISCOVERY_DAILY_BUDGET_CAP=20

PORT=4000
